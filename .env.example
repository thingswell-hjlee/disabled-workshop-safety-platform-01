# ============================================================
# Environment Configuration Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# ============================================================

# --- Site Configuration ---
SITE_ID=SITE-001
SITE_NAME=장애인직업재활시설_A

# --- Edge AI Server ---
EDGE_SERVER_HOST=192.168.30.10
EDGE_GPU_DEVICE=0
AI_MODEL_PATH=/models/current
AI_CONFIDENCE_THRESHOLD=0.7

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Database (Local) ---
LOCAL_DB_PATH=/data/events.db

# --- Database (Cloud - PostgreSQL) ---
CLOUD_DB_HOST=
CLOUD_DB_PORT=5432
CLOUD_DB_NAME=safety_platform
CLOUD_DB_USER=
CLOUD_DB_PASSWORD=

# --- AWS Configuration ---
AWS_REGION=ap-northeast-2
AWS_IOT_ENDPOINT=
AWS_S3_BUCKET=
AWS_IOT_CERT_PATH=/certs/device.pem.crt
AWS_IOT_KEY_PATH=/certs/device.pem.key
AWS_IOT_CA_PATH=/certs/root-CA.crt

# --- Dashboard ---
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=
JWT_EXPIRY_MINUTES=30

# --- NVR ---
NVR_HOST=192.168.10.200
NVR_API_PORT=80

# --- Alarm ---
ALARM_GPIO_PIN_SIREN=17
ALARM_GPIO_PIN_LIGHT=27
FIRE_CONTACT_GPIO_PIN=22

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
