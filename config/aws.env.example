# ============================================================
# AWS Cloud Configuration Template
# Copy to .env or source before running cloud-related services
#
# AWS_MODE: mock (로컬 테스트) | live (실제 AWS 연결)
# ============================================================

# --- AWS Mode ---
AWS_MODE=mock

# --- AWS General ---
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=

# --- AWS IoT Core ---
AWS_IOT_ENDPOINT=
AWS_IOT_CERT_PATH=/certs/device.pem.crt
AWS_IOT_KEY_PATH=/certs/device.pem.key
AWS_IOT_CA_PATH=/certs/root-CA.crt
AWS_IOT_CLIENT_ID=SITE-001-edge-01

# --- AWS S3 ---
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2

# --- AWS RDS (PostgreSQL) ---
CLOUD_DB_HOST=localhost
CLOUD_DB_PORT=5432
CLOUD_DB_NAME=safety_platform
CLOUD_DB_USER=safety_admin
CLOUD_DB_PASSWORD=safety_password

# --- Local MQTT (Mock Mode) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# --- Site Configuration ---
SITE_ID=SITE-001

# --- Dashboard Backend ---
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=dev-secret-key-change-in-production
JWT_EXPIRY_MINUTES=30

# --- Logging ---
LOG_LEVEL=INFO
